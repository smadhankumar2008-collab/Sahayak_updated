# Sahayak AI Environment Variables
# Copy this file to .env and fill in your keys

# LLM Provider (optional - system works without it using extractive RAG)
OPENAI_API_KEY=
# Alternative: Groq, Anthropic, etc.
GROQ_API_KEY=

# Embedding model (optional - defaults to TF-IDF if not available)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store path
VECTOR_STORE_PATH=backend/data/vector_store
METADATA_PATH=backend/data/metadata.json

# Server
PORT=8000
HOST=0.0.0.0

# RAG settings
TOP_K=6
EVIDENCE_THRESHOLD=0.15

# Allowed domains for URL crawling
ALLOWED_DOMAINS=gov.in,nic.in,cooperation.gov.in,pib.gov.in,nabard.org,pmfby.gov.in,myscheme.gov.in,indiacode.nic.in,crcs.gov.in,darpg.gov.in,pgportal.gov.in,ncdc.in

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
